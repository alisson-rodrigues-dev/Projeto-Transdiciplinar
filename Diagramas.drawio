  <!-- 6. MAPA NAVEGACIONAL -->
  <diagram name="6. Mapa Navegacional" id="diag-navegacional">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title6" value="Mapa Navegacional da Aplicação Web (Rotas ASP.NET Core MVC)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1A120B;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <!-- Telas -->
        <mxCell id="nav_vitrine" value="&lt;b&gt;Vitrine / Home&lt;/b&gt;&#xa;URL: / ou /Home/Index&#xa;5 Sabores Gourmet (Ordem Invertida)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nav_carrinho" value="&lt;b&gt;Carrinho de Compras&lt;/b&gt;&#xa;URL: /Carrinho&#xa;Edição de Qtd &amp; Frete R$ 6,00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="240" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nav_auth" value="&lt;b&gt;Autenticação&lt;/b&gt;&#xa;URL: /Conta/Login ou /Cadastro&#xa;Identificação de Sessão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nav_checkout" value="&lt;b&gt;Checkout e Pagamento&lt;/b&gt;&#xa;URL: /Checkout&#xa;Endereço &amp; PIX / Cartão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="240" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nav_rastreio" value="&lt;b&gt;Rastreamento em Tempo Real&lt;/b&gt;&#xa;URL: /Rastreio/{id}&#xa;Linha do Tempo (4 Estágios)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nav_conta" value="&lt;b&gt;Minha Conta / Histórico&lt;/b&gt;&#xa;URL: /Conta/Perfil&#xa;Dados Cadastrais e Pedidos Feitos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nav_operador" value="&lt;b&gt;Painel do Operador (Restrito)&lt;/b&gt;&#xa;URL: /Operador&#xa;Gestão e Atualização de Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#856404;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="240" height="70" as="geometry" />
        </mxCell>
        <!-- Navegações -->
        <mxCell id="ne1" value="Adicionar cupcake" style="endArrow=block;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="nav_vitrine" target="nav_carrinho"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne2" value="Fazer login" style="endArrow=block;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="nav_vitrine" target="nav_auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne3" value="Avançar checkout" style="endArrow=block;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="nav_carrinho" target="nav_checkout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne4" value="Confirmar pagamento" style="endArrow=block;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="nav_checkout" target="nav_rastreio"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne5" value="Acessar histórico" style="endArrow=block;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="nav_vitrine" target="nav_conta"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ne6" value="Acessar painel da loja" style="endArrow=block;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="nav_vitrine" target="nav_operador"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
