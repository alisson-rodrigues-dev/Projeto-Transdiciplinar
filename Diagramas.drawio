  <!-- 2. CLASSES DE DOMÍNIO / PERSISTÊNCIA (C#) -->
  <diagram name="2. Classes de Domínio C#" id="diag-classes">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title2" value="Diagrama de Classes de Domínio e Persistência (C# ASP.NET Core MVC)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1A120B;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <!-- Classe Cliente -->
        <mxCell id="cls_cliente" value="&lt;b&gt;Cliente&lt;/b&gt;&#xa;--&#xa;+ Id: int&#xa;+ Nome: string&#xa;+ Email: string&#xa;+ SenhaHash: string&#xa;+ Telefone: string&#xa;+ EnderecoPadrao: string&#xa;+ CriadoEm: DateTime&#xa;--&#xa;+ ValidarSenha(senha: string): bool" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="240" height="170" as="geometry" />
        </mxCell>
        <!-- Classe Cupcake / Produto -->
        <mxCell id="cls_produto" value="&lt;b&gt;Produto / Cupcake&lt;/b&gt;&#xa;--&#xa;+ Id: int&#xa;+ Nome: string&#xa;+ Descricao: string&#xa;+ Preco: decimal&#xa;+ Disponivel: bool&#xa;+ Categoria: string&#xa;+ ImagemUrl: string&#xa;+ CriadoEm: DateTime&#xa;--&#xa;+ ObterPrecoFormatado(): string" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="80" width="240" height="180" as="geometry" />
        </mxCell>
        <!-- Classe Carrinho -->
        <mxCell id="cls_carrinho" value="&lt;b&gt;CarrinhoViewModel&lt;/b&gt;&#xa;--&#xa;+ Itens: List&lt;ItemCarrinho&gt;&#xa;+ Subtotal: decimal&#xa;+ TaxaEntrega: decimal = 6.00m&#xa;+ Total: decimal&#xa;--&#xa;+ AdicionarItem(p: Produto, qtd: int)&#xa;+ AtualizarQtd(produtoId: int, qtd: int)&#xa;+ RemoverItem(produtoId: int)&#xa;+ Limpar()" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="280" height="180" as="geometry" />
        </mxCell>
        <!-- Classe ItemCarrinho -->
        <mxCell id="cls_itemc" value="&lt;b&gt;ItemCarrinho&lt;/b&gt;&#xa;--&#xa;+ ProdutoId: int&#xa;+ Nome: string&#xa;+ PrecoUnitario: decimal&#xa;+ Quantidade: int&#xa;+ ImagemUrl: string&#xa;--&#xa;+ Subtotal: decimal" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="320" width="280" height="140" as="geometry" />
        </mxCell>
        <!-- Classe Pedido -->
        <mxCell id="cls_pedido" value="&lt;b&gt;Pedido&lt;/b&gt;&#xa;--&#xa;+ Id: int&#xa;+ ClienteId: int&#xa;+ DataPedido: DateTime&#xa;+ ValorProdutos: decimal&#xa;+ TaxaEntrega: decimal = 6.00m&#xa;+ ValorTotal: decimal&#xa;+ FormaPagamento: string&#xa;+ StatusPagamento: string&#xa;+ StatusEntrega: string&#xa;+ EnderecoEntrega: string&#xa;+ PrazoEstimado: string&#xa;+ Observacoes: string&#xa;--&#xa;+ AvancarStatusEntrega()" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="260" height="240" as="geometry" />
        </mxCell>
        <!-- Classe ItemPedido -->
        <mxCell id="cls_itemp" value="&lt;b&gt;ItemPedido&lt;/b&gt;&#xa;--&#xa;+ Id: int&#xa;+ PedidoId: int&#xa;+ ProdutoId: int&#xa;+ Quantidade: int&#xa;+ PrecoUnitario: decimal&#xa;+ Subtotal: decimal&#xa;--&#xa;+ Pedido: Pedido&#xa;+ Produto: Produto" style="shape=rect;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FAF8F5;strokeColor=#C58940;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="280" height="160" as="geometry" />
        </mxCell>
        <!-- Relacionamentos -->
        <mxCell id="rel1" value="1" style="endArrow=none;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="cls_cliente" target="cls_pedido"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel1_card" value="0..*" style="edgeLabel;html=1;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="rel1"><mxGeometry x="0.8" relative="1" as="geometry" /></mxCell>
        <mxCell id="rel2" value="1" style="endArrow=none;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="cls_pedido" target="cls_itemp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel2_card" value="1..*" style="edgeLabel;html=1;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="rel2"><mxGeometry x="0.8" relative="1" as="geometry" /></mxCell>
        <mxCell id="rel3" value="1" style="endArrow=none;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="cls_produto" target="cls_itemp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel3_card" value="0..*" style="edgeLabel;html=1;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="rel3"><mxGeometry x="0.8" relative="1" as="geometry" /></mxCell>
        <mxCell id="rel4" value="1" style="endArrow=none;html=1;strokeColor=#1A120B;" edge="1" parent="1" source="cls_carrinho" target="cls_itemc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rel4_card" value="0..*" style="edgeLabel;html=1;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="rel4"><mxGeometry x="0.8" relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- 3. SEQUÊNCIA DE CONFIRMAÇÃO DE PEDIDO -->
  <diagram name="3. Sequência de Confirmação" id="diag-sequencia">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title3" value="Diagrama de Sequência — Checkout e Processamento do Pedido (ASP.NET Core)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1A120B;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="850" height="40" as="geometry" />
        </mxCell>
        <!-- Lifelines -->
        <mxCell id="ll_cliente" value="Cliente&#xa;(Navegador)" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ll_view" value="View: Checkout&#xa;(Razor .cshtml)" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ll_controller" value="CheckoutController&#xa;(ASP.NET Core MVC)" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ll_db" value="AppDbContext&#xa;(SQLite 3FN)" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#FAF8F5;strokeColor=#C58940;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="160" height="50" as="geometry" />
        </mxCell>
        <!-- Linhas de vida (dashed) -->
        <mxCell id="line1" style="dashed=1;endArrow=none;html=1;strokeColor=#C58940;" edge="1" parent="1" source="ll_cliente"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="700" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="line2" style="dashed=1;endArrow=none;html=1;strokeColor=#C58940;" edge="1" parent="1" source="ll_view"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="700" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="line3" style="dashed=1;endArrow=none;html=1;strokeColor=#C58940;" edge="1" parent="1" source="ll_controller"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="700" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="line4" style="dashed=1;endArrow=none;html=1;strokeColor=#C58940;" edge="1" parent="1" source="ll_db"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="700" as="targetPoint" /></mxGeometry></mxCell>
        <!-- Mensagens -->
        <mxCell id="msg1" value="1. Preenche endereço e seleciona PIX/Cartão" style="endArrow=block;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="170" as="sourcePoint" /><mxPoint x="360" y="170" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="msg2" value="2. POST /Checkout/Finalizar (Dados do Pedido)" style="endArrow=block;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="220" as="sourcePoint" /><mxPoint x="630" y="220" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="msg3" value="3. Validar ModelState &amp; Itens do Carrinho" style="endArrow=block;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="630" y="270" as="sourcePoint" /><mxPoint x="630" y="300" as="targetPoint" /><Array as="points"><mxPoint x="670" y="270" /><mxPoint x="670" y="300" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="msg4" value="4. Simular Autorização de Pagamento (PIX / Cartão)" style="endArrow=block;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="630" y="340" as="sourcePoint" /><mxPoint x="630" y="370" as="targetPoint" /><Array as="points"><mxPoint x="670" y="340" /><mxPoint x="670" y="370" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="msg5" value="5. Gravação Atômica (Add Pedido &amp; ItensPedido)" style="endArrow=block;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="630" y="420" as="sourcePoint" /><mxPoint x="920" y="420" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="msg6" value="6. SaveChangesAsync() ➔ SQLite" style="endArrow=block;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="920" y="470" as="sourcePoint" /><mxPoint x="920" y="490" as="targetPoint" /><Array as="points"><mxPoint x="950" y="470" /><mxPoint x="950" y="490" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="msg7" value="7. Retorna Pedido Criado (Id gerado)" style="endArrow=open;dashed=1;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="920" y="530" as="sourcePoint" /><mxPoint x="630" y="530" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="msg8" value="8. Limpar Carrinho da Sessão" style="endArrow=block;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="630" y="570" as="sourcePoint" /><mxPoint x="630" y="590" as="targetPoint" /><Array as="points"><mxPoint x="670" y="570" /><mxPoint x="670" y="590" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="msg9" value="9. RedirectToAction(&quot;Index&quot;, &quot;Rastreio&quot;, id)" style="endArrow=open;dashed=1;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="630" y="630" as="sourcePoint" /><mxPoint x="360" y="630" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="msg10" value="10. Exibe Tela de Rastreio em Tempo Real" style="endArrow=open;dashed=1;html=1;strokeColor=#1A120B;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="670" as="sourcePoint" /><mxPoint x="130" y="670" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

