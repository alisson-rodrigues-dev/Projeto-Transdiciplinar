@model LojaCupcakes.Models.OperadorViewModel
@{
    ViewData["Title"] = "Painel do Operador";
}

<div style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <span class="hero-tag" style="background: var(--color-warning-bg); color: var(--color-warning); border-color: rgba(237,108,2,0.3);">
                Área de Gestão da Confeitaria
            </span>
            <h2 style="font-family: var(--font-serif); font-size: 2rem; color: var(--color-dark); margin-top: 6px;">
                ⚙️ Painel Operacional de Pedidos
            </h2>
            <p style="color: var(--color-text-muted); font-size: 0.95rem;">
                Acompanhe as encomendas em tempo real e atualize o status de preparo e entrega.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline">
            🔄 Atualizar Lista
        </a>
    </div>

    <!-- Cards de Métricas Operacionais -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 30px;">
        <div style="background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 18px; text-align: center;">
            <span style="font-size: 0.8rem; color: var(--color-text-muted); text-transform: uppercase; font-weight: 600;">Total de Pedidos</span>
            <strong style="display: block; font-size: 1.8rem; color: var(--color-dark); margin-top: 4px;">@Model.Pedidos.Count</strong>
        </div>
        <div style="background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 18px; text-align: center;">
            <span style="font-size: 0.8rem; color: var(--color-warning); text-transform: uppercase; font-weight: 600;">Recebidos</span>
            <strong style="display: block; font-size: 1.8rem; color: var(--color-warning); margin-top: 4px;">@Model.TotalRecebidos</strong>
        </div>
        <div style="background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 18px; text-align: center;">
            <span style="font-size: 0.8rem; color: var(--color-primary); text-transform: uppercase; font-weight: 600;">Em Preparo</span>
            <strong style="display: block; font-size: 1.8rem; color: var(--color-primary); margin-top: 4px;">@Model.TotalPreparando</strong>
        </div>
        <div style="background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 18px; text-align: center;">
            <span style="font-size: 0.8rem; color: #1976D2; text-transform: uppercase; font-weight: 600;">Em Rota</span>
            <strong style="display: block; font-size: 1.8rem; color: #1976D2; margin-top: 4px;">@Model.TotalEmRota</strong>
        </div>
        <div style="background: #FFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 18px; text-align: center;">
            <span style="font-size: 0.8rem; color: var(--color-success); text-transform: uppercase; font-weight: 600;">Entregues</span>
            <strong style="display: block; font-size: 1.8rem; color: var(--color-success); margin-top: 4px;">@Model.TotalEntregues</strong>
        </div>
    </div>

    <!-- Tabela de Pedidos Operacionais -->
    <div style="background: #FFF; border-radius: var(--radius-md); border: 1px solid var(--color-border); padding: 24px; box-shadow: var(--shadow-sm);">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>ID Pedido</th>
                    <th>Cliente / Contato</th>
                    <th>Endereço</th>
                    <th>Total</th>
                    <th>Pagamento</th>
                    <th>Status Atual</th>
                    <th>Ação Operacional</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pedidos)
                {
                    <tr>
                        <td style="font-weight: 700;">#@p.Id.ToString("D4")</td>
                        <td>
                            <strong style="display: block; color: var(--color-dark);">@p.Cliente?.Nome</strong>
                            <small style="color: var(--color-text-muted);">@p.Cliente?.Email</small>
                        </td>
                        <td style="font-size: 0.88rem; max-width: 220px;">
                            @p.EnderecoEntrega
                        </td>
                        <td style="font-weight: 700; color: var(--color-dark);">@p.TotalFormatado</td>
                        <td>
                            <span style="font-size: 0.78rem; font-weight: 600; background: var(--color-bg); padding: 3px 8px; border-radius: var(--radius-full);">
                                @p.FormaPagamento (@p.StatusPagamento)
                            </span>
                        </td>
                        <td>
                            <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary);">
                                @p.StatusEntrega
                            </span>
                        </td>
                        <td>
                            <form asp-controller="Operador" asp-action="AtualizarStatus" method="post" style="display: flex; gap: 6px; align-items: center;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pedidoId" value="@p.Id" />
                                <select name="novoStatus" class="form-control" style="padding: 6px 8px; font-size: 0.82rem; width: 130px;">
                                    <option value="RECEBIDO" selected="@(p.StatusEntrega == "RECEBIDO")">RECEBIDO</option>
                                    <option value="PREPARANDO" selected="@(p.StatusEntrega == "PREPARANDO")">PREPARANDO</option>
                                    <option value="EM_ROTA" selected="@(p.StatusEntrega == "EM_ROTA")">EM_ROTA</option>
                                    <option value="ENTREGUE" selected="@(p.StatusEntrega == "ENTREGUE")">ENTREGUE</option>
                                </select>
                                <button type="submit" class="btn btn-primary" style="padding: 6px 10px; font-size: 0.8rem;" title="Salvar alteração">
                                    Salvar
                                </button>
                                <a asp-controller="Rastreio" asp-action="Index" asp-route-id="@p.Id" class="btn btn-outline" style="padding: 6px 8px; font-size: 0.8rem;" title="Ver rastreio do cliente">
                                    👁
                                </a>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
