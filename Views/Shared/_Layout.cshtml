@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject LojaCupcakes.Services.CarrinhoService CarrinhoService

@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var usuarioId = session?.GetInt32(LojaCupcakes.Controllers.ContaController.SessionUsuarioId);
    var usuarioNome = session?.GetString(LojaCupcakes.Controllers.ContaController.SessionUsuarioNome);
    var usuarioEmail = session?.GetString(LojaCupcakes.Controllers.ContaController.SessionUsuarioEmail);
    var estaLogado = usuarioId.HasValue;
    var isAdmin = string.Equals(usuarioEmail, LojaCupcakes.Controllers.ContaController.EmailAdmin, StringComparison.OrdinalIgnoreCase);
    var qtdCarrinho = CarrinhoService.ObterCarrinho().QuantidadeTotalItens;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Le Cupcake Gourmet</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- CSS Customizado Gourmet -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Topbar Acadêmica Institucional -->
    <div class="academic-notice">
        <div class="site-container">
            <span>✨ PIT II — Projeto Integrador Transdisciplinar em Engenharia de Software II | Padrão MVC em C# (.NET 10)</span>
        </div>
    </div>

    <!-- Header Principal -->
    <header class="site-header">
        <div class="site-container">
            <nav class="site-nav">
                <!-- Marca / Logo Profissional (Direciona para a Apresentação da Marca na V2) -->
                <a asp-controller="Home" asp-action="Apresentacao" class="brand-logo" title="Conheça a história e apresentação da marca Le Cupcake">
                    <img src="~/images/logo-lecupcake.svg" alt="Le Cupcake Gourmet" class="brand-logo-img" />
                </a>

                <!-- Botão Toggle Hamburguer para Dispositivos Móveis -->
                <button type="button" class="nav-toggle-btn" id="navToggleBtn" aria-label="Abrir menu de navegação">
                    <span class="nav-toggle-bar"></span>
                    <span class="nav-toggle-bar"></span>
                    <span class="nav-toggle-bar"></span>
                </button>

                <!-- Links de Navegação Responsivos -->
                <ul class="nav-links" id="navMenu">
                    <li><a asp-controller="Home" asp-action="Apresentacao" class="nav-link">Apresentação</a></li>
                    <li><a asp-controller="Home" asp-action="Index" class="nav-link">Cardápio & Vitrine</a></li>
                    <li><a asp-controller="Rastreio" asp-action="Index" class="nav-link">Rastrear Pedido</a></li>
                    
                    @if (estaLogado)
                    {
                        <li><a asp-controller="Conta" asp-action="Index" class="nav-link">👤 Painel do Usuário</a></li>

                        @if (isAdmin)
                        {
                            <li><a asp-controller="Operador" asp-action="Index" class="nav-link nav-link-admin">⚙️ Painel da Loja (Admin)</a></li>
                        }

                        <li>
                            <a asp-controller="Conta" asp-action="Logout" class="nav-link nav-link-danger">Sair</a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a asp-controller="Conta" asp-action="Login" class="user-chip">
                                <span>👤 Entrar</span>
                            </a>
                        </li>
                    }

                    <!-- Botão do Carrinho -->
                    <li>
                        <a asp-controller="Carrinho" asp-action="Index" class="nav-cart-btn">
                            <span>🛒</span>
                            <span class="cart-label">Carrinho</span>
                            <span class="cart-badge">@qtdCarrinho</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Notificações Flash TempData -->
    <div class="site-container">
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert-banner alert-success">
                <span>✔ @TempData["Sucesso"]</span>
            </div>
        }
        @if (TempData["Aviso"] != null)
        {
            <div class="alert-banner alert-warning">
                <span>⚠ @TempData["Aviso"]</span>
            </div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="alert-banner alert-danger">
                <span>✖ @TempData["Erro"]</span>
            </div>
        }
    </div>

    <!-- Corpo Principal da Página -->
    <main class="site-container">
        @RenderBody()
    </main>

    <!-- Rodapé -->
    <footer class="site-footer">
        <div class="site-container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <h4>🧁 Le Cupcake Gourmet</h4>
                    <p>Produzimos artesanalmente cada cupcake com ingredientes selecionados, cacau nobre e amor pela confeitaria fina.</p>
                    <p style="margin-top: 10px; font-size: 0.85rem; color: var(--color-accent);">
                        🚀 Entrega expressa na região próxima em 15 a 30 minutos com taxa fixa de R$ 6,00.
                    </p>
                </div>
                <div class="footer-col">
                    <h5>Navegação Rápida</h5>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Vitrine</a></li>
                        <li><a asp-controller="Carrinho" asp-action="Index">Meu Carrinho</a></li>
                        <li><a asp-controller="Conta" asp-action="Index">Minha Conta</a></li>
                        @if (isAdmin)
                        {
                            <li><a asp-controller="Operador" asp-action="Index">Painel da Loja (Admin)</a></li>
                        }
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Projeto Acadêmico</h5>
                    <ul>
                        <li><strong>Disciplina:</strong> PIT II (Turma 001)</li>
                        <li><strong>Arquitetura:</strong> ASP.NET Core MVC</li>
                        <li><strong>Banco de Dados:</strong> SQLite 3FN</li>
                        <li><strong>Ambiente:</strong> Localhost (.NET 10)</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Le Cupcake Gourmet — Trabalho acadêmico desenvolvido em C# com código aberto no GitHub.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
