@model LojaCupcakes.Models.CheckoutViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Finalizar Pedido";
    var clienteIdLogado = HttpContextAccessor.HttpContext?.Session.GetInt32(LojaCupcakes.Controllers.ContaController.SessionUsuarioId);
    var estaLogado = clienteIdLogado.HasValue;
}

<div style="margin-top: 30px;">
    <h2 style="font-family: var(--font-serif); font-size: 2rem; color: var(--color-dark); margin-bottom: 8px;">
        📦 Finalização da Compra
    </h2>
    <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 24px;">
        Informe seu endereço de entrega e selecione a forma de pagamento demonstrativo.
    </p>

    <form asp-controller="Checkout" asp-action="Finalizar" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert-banner alert-danger"></div>

        <div class="checkout-grid">
            <!-- Coluna de Formulários (Endereço e Pagamento) -->
            <div>
                <!-- Box 1: Dados do Destinatário e Endereço -->
                <div class="checkout-box">
                    <h3><span>📍</span> 1. Destinatário e Endereço de Entrega</h3>

                    <div class="form-row">
                        <div class="form-group" style="flex: 2;">
                            <label asp-for="Nome" class="form-label">Nome Completo *</label>
                            <input asp-for="Nome" class="form-control" placeholder="Ex: Maria da Silva" required />
                            <span asp-validation-for="Nome" style="color: var(--color-danger); font-size: 0.8rem;"></span>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label asp-for="Telefone" class="form-label">Telefone / WhatsApp *</label>
                            <input asp-for="Telefone" class="form-control" placeholder="(11) 99999-9999" required />
                            <span asp-validation-for="Telefone" style="color: var(--color-danger); font-size: 0.8rem;"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">E-mail para Rastreio *</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="cliente@exemplo.com" required />
                        <span asp-validation-for="Email" style="color: var(--color-danger); font-size: 0.8rem;"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex: 3;">
                            <label asp-for="EnderecoEntrega" class="form-label">Rua e Número *</label>
                            <input asp-for="EnderecoEntrega" class="form-control" placeholder="Ex: Av. Paulista, 1500" required />
                            <span asp-validation-for="EnderecoEntrega" style="color: var(--color-danger); font-size: 0.8rem;"></span>
                        </div>
                        <div class="form-group" style="flex: 2;">
                            <label asp-for="Complemento" class="form-label">Complemento</label>
                            <input asp-for="Complemento" class="form-control" placeholder="Apto 42, Bloco B" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Bairro" class="form-label">Bairro</label>
                            <input asp-for="Bairro" class="form-control" placeholder="Bela Vista" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Cidade" class="form-label">Cidade / UF</label>
                            <input asp-for="Cidade" class="form-control" placeholder="São Paulo - SP" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Observacoes" class="form-label">Instruções para o Entregador (Opcional)</label>
                        <input asp-for="Observacoes" class="form-control" placeholder="Ex: Deixar na portaria ou interfone 42" />
                    </div>
                </div>

                <!-- Box 2: Forma de Pagamento -->
                <div class="checkout-box">
                    <h3><span>💳</span> 2. Pagamento Demonstrativo</h3>

                    <!-- Abas de Pagamento -->
                    <div class="payment-tabs">
                        <button type="button" class="payment-tab-btn active" id="tabPix">
                            ⚡ PIX Instantâneo
                        </button>
                        <button type="button" class="payment-tab-btn" id="tabCard">
                            💳 Cartão de Crédito
                        </button>
                    </div>

                    <input type="hidden" asp-for="FormaPagamento" id="inputFormaPagamento" value="PIX" />

                    <!-- Conteúdo Aba PIX -->
                    <div id="boxPix" style="text-align: center; padding: 10px 0;">
                        @if (estaLogado)
                        {
                            <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 16px;">
                                Pague com facilidade pelo aplicativo do seu banco lendo o QR Code abaixo:
                            </p>

                            <!-- QR Code Simulado em SVG -->
                            <div style="background: #FFF; border: 2px dashed var(--color-primary); border-radius: var(--radius-sm); padding: 18px; display: inline-block; margin-bottom: 16px;">
                                <svg width="150" height="150" viewBox="0 0 100 100" fill="#1A120B">
                                    <rect width="100" height="100" fill="#FFFFFF"/>
                                    <path d="M10,10 h25 v25 h-25 z M15,15 v15 h15 v-15 z M19,19 h7 v7 h-7 z" fill="#1A120B"/>
                                    <path d="M65,10 h25 v25 h-25 z M70,15 v15 h15 v-15 z M74,19 h7 v7 h-7 z" fill="#1A120B"/>
                                    <path d="M10,65 h25 v25 h-25 z M15,70 v15 h15 v-15 z M19,74 h7 v7 h-7 z" fill="#1A120B"/>
                                    <rect x="45" y="15" width="10" height="10"/>
                                    <rect x="40" y="35" width="8" height="8"/>
                                    <rect x="55" y="35" width="8" height="8"/>
                                    <rect x="45" y="55" width="12" height="12"/>
                                    <rect x="65" y="55" width="8" height="8"/>
                                    <rect x="75" y="75" width="15" height="15"/>
                                </svg>
                            </div>

                            <div style="display: flex; gap: 8px; max-width: 450px; margin: 0 auto 12px;">
                                <input type="text" id="chavePixInput" readonly value="00020126580014br.gov.bcb.pix0136lecupcake-gourmet-chave-simulada" class="form-control" style="font-size: 0.8rem; background: var(--color-bg);" />
                                <button type="button" class="btn btn-outline" onclick="copiarChavePix()" style="font-size: 0.85rem; white-space: nowrap;">
                                    Copiar
                                </button>
                            </div>
                            <span style="font-size: 0.8rem; color: var(--color-success); font-weight: 600;">
                                ✔ Aprovação imediata e envio automático para a cozinha!
                            </span>
                        }
                        else
                        {
                            <div style="background: #FFFDF9; border: 2px dashed #D4A373; border-radius: 12px; padding: 24px 18px; margin: 10px auto; max-width: 500px;">
                                <div style="font-size: 2.2rem; margin-bottom: 8px;">🔒</div>
                                <h4 style="font-family: var(--font-serif); color: var(--color-primary); font-size: 1.15rem; margin-bottom: 8px;">
                                    QR Code PIX Protegido
                                </h4>
                                <p style="color: var(--color-text-muted); font-size: 0.88rem; line-height: 1.5; margin-bottom: 16px;">
                                    Para a sua segurança, rastreabilidade fiscal e confirmação instantânea do pedido, o <strong>QR Code oficial do PIX</strong> só é gerado após você estar conectado à sua conta.
                                </p>
                                <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                                    <a href="/Conta/Login?returnUrl=/Checkout" class="btn btn-primary" style="font-size: 0.85rem; padding: 8px 18px;">
                                        🔑 Entrar na Minha Conta
                                    </a>
                                    <a href="/Conta/Cadastro?returnUrl=/Checkout" class="btn btn-outline" style="font-size: 0.85rem; padding: 8px 18px;">
                                        ✨ Cadastrar-se Rapidamente
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Conteúdo Aba Cartão de Crédito -->
                    <div id="boxCard" style="display: none; padding: 10px 0;">
                        <div class="form-group">
                            <label class="form-label">Número do Cartão Demonstrativo</label>
                            <input asp-for="NumeroCartao" class="form-control" placeholder="4532 •••• •••• 8899" maxlength="19" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nome do Titular (como no cartão)</label>
                            <input asp-for="NomeCartao" class="form-control" placeholder="Ex: MARIA SILVA" />
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Validade (MM/AA)</label>
                                <input asp-for="ValidadeCartao" class="form-control" placeholder="12/28" maxlength="5" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">CVV</label>
                                <input asp-for="CvvCartao" class="form-control" placeholder="123" maxlength="4" />
                            </div>
                        </div>
                        <span style="font-size: 0.8rem; color: var(--color-text-muted);">
                            ℹ Transação em ambiente de teste seguro com autorização instantânea.
                        </span>
                    </div>
                </div>
            </div>

            <!-- Coluna Resumo da Compra -->
            <div>
                <div class="summary-card" style="position: sticky; top: 100px;">
                    <h3>Resumo da Compra</h3>

                    <div style="max-height: 220px; overflow-y: auto; margin-bottom: 16px; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 12px;">
                        @foreach (var it in Model.Carrinho.Itens)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; font-size: 0.9rem;">
                                <span>@it.Quantidade x @it.Nome</span>
                                <strong>@it.SubtotalFormatado</strong>
                            </div>
                        }
                    </div>

                    <div class="summary-row">
                        <span>Subtotal dos Produtos</span>
                        <span>@Model.Carrinho.SubtotalFormatado</span>
                    </div>

                    <div class="summary-row">
                        <div>
                            <span>Taxa Fixa de Entrega</span>
                            <small style="display: block; font-size: 0.75rem; color: var(--color-primary);">15 a 30 min</small>
                        </div>
                        <span style="color: var(--color-primary); font-weight: 600;">@Model.Carrinho.TaxaFormatada</span>
                    </div>

                    <div class="summary-row summary-total">
                        <span>Total a Pagar</span>
                        <span style="color: var(--color-primary);">@Model.Carrinho.TotalFormatado</span>
                    </div>

                    <div style="margin-top: 24px;">
                        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1.05rem;">
                            Confirmar e Finalizar Pedido ✔
                        </button>
                    </div>

                    <div style="margin-top: 14px; text-align: center;">
                        <a asp-controller="Carrinho" asp-action="Index" style="font-size: 0.85rem; color: var(--color-text-muted);">
                            ← Voltar ao carrinho para alterar itens
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
