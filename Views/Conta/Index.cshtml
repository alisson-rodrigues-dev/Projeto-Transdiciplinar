@model LojaCupcakes.Models.Cliente
@{
    ViewData["Title"] = "Minha Conta";
    var pedidos = ViewBag.Pedidos as List<LojaCupcakes.Models.Pedido> ?? new List<LojaCupcakes.Models.Pedido>();
}

<div style="margin-top: 30px;">
    <h2 style="font-family: var(--font-serif); font-size: 2rem; color: var(--color-dark); margin-bottom: 8px;">
        👤 Painel do Cliente
    </h2>
    <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 24px;">
        Gerencie seus dados e confira o histórico das suas compras.
    </p>

    <div style="display: grid; grid-template-columns: 320px 1fr; gap: 30px;">
        <!-- Card Dados Cadastrais -->
        <div style="background: #FFF; border-radius: var(--radius-md); border: 1px solid var(--color-border); padding: 24px; box-shadow: var(--shadow-sm); height: fit-content;">
            <div style="text-align: center; margin-bottom: 18px;">
                <div style="width: 70px; height: 70px; border-radius: 50%; background: var(--color-accent-soft); color: var(--color-dark); font-size: 2rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;">
                    🧁
                </div>
                <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-dark);">@Model.Nome</h3>
                <span style="font-size: 0.85rem; color: var(--color-text-muted);">@Model.Email</span>
            </div>

            <div style="border-top: 1px solid var(--color-border-subtle); padding-top: 16px; font-size: 0.9rem;">
                <p style="margin-bottom: 8px;">
                    <strong>Telefone:</strong> @(Model.Telefone ?? "Não informado")
                </p>
                <p style="margin-bottom: 8px;">
                    <strong>Endereço Padrão:</strong> @(Model.EnderecoPadrao ?? "Não cadastrado")
                </p>
                <p style="margin-bottom: 8px;">
                    <strong>Cliente desde:</strong> @Model.CriadoEm.ToString("dd/MM/yyyy")
                </p>
            </div>

            <div style="margin-top: 20px;">
                <a asp-controller="Conta" asp-action="Logout" class="btn btn-outline" style="width: 100%; color: var(--color-danger); border-color: rgba(211,47,47,0.3);">
                    Encerrar Sessão
                </a>
            </div>
        </div>

        <!-- Tabela de Histórico de Pedidos -->
        <div style="background: #FFF; border-radius: var(--radius-md); border: 1px solid var(--color-border); padding: 24px; box-shadow: var(--shadow-sm);">
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-dark); margin-bottom: 16px;">
                Meus Pedidos Recentes
            </h3>

            @if (!pedidos.Any())
            {
                <div style="text-align: center; padding: 40px 10px; color: var(--color-text-muted);">
                    <p style="margin-bottom: 16px;">Você ainda não realizou nenhum pedido na nossa confeitaria.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        Fazer Meu Primeiro Pedido
                    </a>
                </div>
            }
            else
            {
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Nº Pedido</th>
                            <th>Data</th>
                            <th>Total c/ Frete</th>
                            <th>Pagamento</th>
                            <th>Status Entrega</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pedidos)
                        {
                            <tr>
                                <td style="font-weight: 700;">#@p.Id.ToString("D4")</td>
                                <td>@p.DataPedido.ToString("dd/MM/yy HH:mm")</td>
                                <td style="font-weight: 600; color: var(--color-dark);">@p.TotalFormatado</td>
                                <td>
                                    <span style="font-size: 0.8rem; font-weight: 600; background: var(--color-bg); padding: 4px 8px; border-radius: var(--radius-full);">
                                        @p.FormaPagamento
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary);">
                                        @p.StatusEntrega
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="Rastreio" asp-action="Index" asp-route-id="@p.Id" class="btn btn-outline" style="padding: 6px 12px; font-size: 0.82rem;">
                                        Rastrear ➔
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
