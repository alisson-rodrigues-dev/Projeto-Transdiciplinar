@model LojaCupcakes.Models.CarrinhoViewModel
@{
    ViewData["Title"] = "Meu Carrinho de Compras";
}

<div style="margin-top: 30px;">
    <h2 style="font-family: var(--font-serif); font-size: 2rem; color: var(--color-dark); margin-bottom: 8px;">
        🛒 Carrinho de Compras
    </h2>
    <p style="color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 24px;">
        Confira seus cupcakes selecionados antes de prosseguir para a entrega e pagamento.
    </p>

    @if (!Model.Itens.Any())
    {
        <div style="background: #FFF; border-radius: var(--radius-md); border: 1px solid var(--color-border); padding: 60px 20px; text-align: center; margin-top: 20px;">
            <span style="font-size: 3.5rem; display: block; margin-bottom: 16px;">🧁</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-dark); margin-bottom: 10px;">Seu carrinho está vazio</h3>
            <p style="color: var(--color-text-muted); max-width: 450px; margin: 0 auto 24px;">
                Você ainda não adicionou nenhum dos nossos deliciosos cupcakes gourmet. Dê uma olhada no nosso menu exclusivo!
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                Explorar Vitrine de Sabores
            </a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <!-- Tabela de Itens -->
            <div class="cart-table-card">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Preço Unitário</th>
                            <th>Quantidade</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Itens)
                        {
                            <tr>
                                <td>
                                    <div class="cart-item-info">
                                        <img src="@item.ImagemUrl" alt="@item.Nome" class="cart-thumb" />
                                        <div>
                                            <strong style="color: var(--color-dark); font-size: 1rem; display: block;">@item.Nome</strong>
                                            <span style="font-size: 0.8rem; color: var(--color-primary);">Cupcake Gourmet</span>
                                        </div>
                                    </div>
                                </td>
                                <td style="font-weight: 600;">@item.PrecoUnitarioFormatado</td>
                                <td>
                                    <div class="qty-stepper">
                                        <form asp-controller="Carrinho" asp-action="AtualizarQtd" method="post" style="display: inline;">
                                            <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                                            <input type="hidden" name="quantidade" value="@(item.Quantidade - 1)" />
                                            <button type="submit" class="qty-btn" title="Diminuir quantidade">−</button>
                                        </form>

                                        <span class="qty-input" style="line-height: 32px;">@item.Quantidade</span>

                                        <form asp-controller="Carrinho" asp-action="AtualizarQtd" method="post" style="display: inline;">
                                            <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                                            <input type="hidden" name="quantidade" value="@(item.Quantidade + 1)" />
                                            <button type="submit" class="qty-btn" title="Aumentar quantidade">+</button>
                                        </form>
                                    </div>
                                </td>
                                <td style="font-weight: 700; color: var(--color-dark);">@item.SubtotalFormatado</td>
                                <td>
                                    <form asp-controller="Carrinho" asp-action="Remover" method="post">
                                        <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                                        <button type="submit" class="btn btn-outline" style="padding: 6px 10px; font-size: 0.8rem; color: var(--color-danger); border-color: rgba(211,47,47,0.3);" title="Remover item">
                                            Excluir
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--color-border-subtle);">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline">
                        ← Continuar Comprando
                    </a>

                    <form asp-controller="Carrinho" asp-action="Limpar" method="post">
                        <button type="submit" class="btn btn-outline" style="color: var(--color-text-muted); font-size: 0.85rem;" onclick="return confirm('Deseja realmente esvaziar o carrinho?')">
                            Limpar Carrinho
                        </button>
                    </form>
                </div>
            </div>

            <!-- Resumo Financeiro do Pedido -->
            <div class="summary-card">
                <h3>Resumo do Pedido</h3>

                <div class="summary-row">
                    <span>Itens Selecionados</span>
                    <strong>@Model.QuantidadeTotalItens un.</strong>
                </div>

                <div class="summary-row">
                    <span>Subtotal dos Produtos</span>
                    <span>@Model.SubtotalFormatado</span>
                </div>

                <div class="summary-row">
                    <div>
                        <span>Taxa de Entrega Fixa</span>
                        <small style="display: block; font-size: 0.75rem; color: var(--color-primary);">Prazo: @Model.PrazoEstimado</small>
                    </div>
                    <span style="font-weight: 600; color: var(--color-primary);">@Model.TaxaFormatada</span>
                </div>

                <div class="summary-row summary-total">
                    <span>Total da Compra</span>
                    <span style="color: var(--color-primary);">@Model.TotalFormatado</span>
                </div>

                <div style="margin-top: 24px;">
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1rem; border-radius: var(--radius-sm);">
                        Avançar para o Checkout ➔
                    </a>
                </div>

                <div style="margin-top: 16px; padding: 12px; background: var(--color-bg); border-radius: var(--radius-sm); font-size: 0.8rem; color: var(--color-text-muted); text-align: center;">
                    🔒 Compra segura com confirmação e rastreamento em tempo real.
                </div>
            </div>
        </div>
    }
</div>
